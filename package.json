{
  "name": "nutelch",
  "version": "0.3.0",
  "description": "Chroma relative to the gamut shell (cusp) in OKLCH/LCH. Dependency-free, LUT-backed.",
  "type": "module",
  "author": "David Aerne <meodai@gmail.com>",
  "license": "MIT",
  "homepage": "https://meodai.github.io/nutelch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meodai/nutelch.git"
  },
  "bugs": {
    "url": "https://github.com/meodai/nutelch/issues"
  },
  "keywords": [
    "oklch",
    "lch",
    "color",
    "color-space",
    "gamut",
    "chroma",
    "cusp",
    "saturation",
    "okhsl",
    "css-color"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/nutelch.umd.cjs",
  "module": "./dist/nutelch.js",
  "types": "./dist/nutelch.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/nutelch.d.ts",
        "default": "./dist/nutelch.js"
      },
      "require": {
        "types": "./dist/nutelch.d.cts",
        "default": "./dist/nutelch.umd.cjs"
      }
    },
    "./hct": {
      "import": {
        "types": "./dist/hct.d.ts",
        "default": "./dist/hct.js"
      },
      "require": {
        "types": "./dist/hct.d.cts",
        "default": "./dist/hct.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "hct": [
        "./dist/hct.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build:luts": "tsx scripts/build-luts.ts",
    "eval:luts": "tsx scripts/eval-luts.ts",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.lib.umd.config.ts && tsx scripts/dual-types.ts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@types/node": "^22.0.0",
    "culori": "^4.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
